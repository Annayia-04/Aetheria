# Aetheria Configuration
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Database (choose one)
# SQLite (default, zero-config)
DATABASE_TYPE=sqlite
SQLITE_PATH=./data/aetheria.db

# PostgreSQL (production)
# DATABASE_TYPE=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=aetheria
# PG_USER=aetheria
# PG_PASSWORD=changeme
# PG_SSL=false

# Session / Security
SESSION_SECRET=your-super-secret-session-key-min-32-chars
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LLM sécurisé — proxy serveur (les clés ne vont jamais dans le navigateur)
# LLM_PROVIDER=openai            # openai | openrouter | anthropic | ollama
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=                   # ou OPENAI_API_KEY / OPENROUTER_API_KEY / ANTHROPIC_API_KEY
# LLM_BASE_URL=                  # utile pour Ollama ou un endpoint compatible
# LLM_MAX_TOKENS=2200
# LLM_TIMEOUT_MS=60000
# LLM_RATE_LIMIT_PER_HOUR=12
# LLM_GLOBAL_LIMIT_PER_HOUR=60
# LLM_MAX_CONCURRENT=2
# LLM_ACCESS_CODE=               # optionnel : code demandé dans l'interface