{
  "name": "aetheria",
  "version": "2.0.0",
  "description": "Aetheria — Forge de Héros PWA avec backend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build && node postbuild.js",
    "preview": "vite preview",
    "db:init": "node server/database.js",
    "start": "node server/index.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "sql.js": "^1.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@dicebear/avataaars": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "concurrently": "^8.2.2",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
